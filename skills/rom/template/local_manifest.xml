<?xml version="1.0" encoding="UTF-8"?>
<!--
  Place this at .repo/local_manifests/local_manifest.xml BEFORE running `repo sync`.
  Replace GITHUB_USER_OR_ORG, VENDOR, CODENAME, and BRANCH with real values for
  the target device. Each <project> pulls one extra tree not included in the main
  manifest (device tree, vendor blobs, kernel source).
-->
<manifest>

  <!-- Device tree -->
  <project name="GITHUB_USER_OR_ORG/android_device_VENDOR_CODENAME"
           path="device/VENDOR/CODENAME"
           remote="github"
           revision="BRANCH" />

  <!-- Vendor blobs / proprietary files -->
  <project name="GITHUB_USER_OR_ORG/android_vendor_VENDOR_CODENAME"
           path="vendor/VENDOR/CODENAME"
           remote="github"
           revision="BRANCH" />

  <!-- Kernel source -->
  <project name="GITHUB_USER_OR_ORG/android_kernel_VENDOR_CODENAME"
           path="kernel/VENDOR/CODENAME"
           remote="github"
           revision="BRANCH" />

  <!-- Common device tree (if the SoC/vendor has a shared common tree, e.g. mediatek/sm8xxx-common) -->
  <!--
  <project name="GITHUB_USER_OR_ORG/android_device_VENDOR_COMMON_CODENAME"
           path="device/VENDOR/COMMON_CODENAME"
           remote="github"
           revision="BRANCH" />
  -->

</manifest>
