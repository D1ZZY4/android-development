<?xml version="1.0" encoding="UTF-8"?>
<!--
  LineageOS-style alternative to local_manifest.xml, placed at
  .repo/local_manifests/roomservice.xml. Functionally the same purpose --
  pulls device/vendor/kernel trees not in the main manifest.
  `breakfast CODENAME` will auto-generate a starter version of this if
  the device tree already exists on GitHub under the expected naming
  convention (android_device_VENDOR_CODENAME).
  Replace GITHUB_USER_OR_ORG, VENDOR, CODENAME, and LINEAGE_BRANCH with
  real values for the target device.
-->
<manifest>
  <project name="GITHUB_USER_OR_ORG/android_device_VENDOR_CODENAME"
           path="device/VENDOR/CODENAME"
           remote="github"
           revision="LINEAGE_BRANCH" />
</manifest>
