# build.config template for a GKI (build.sh-based) kernel tree.
# Real trees usually source a base config and override a few fields —
# check for an existing build.config.gki.aarch64 or similar in common/
# before writing this from scratch.

. ${ROOT_DIR}/common/build.config.gki.aarch64 2>/dev/null || true

# Vendor-specific overrides
BUILD_CONFIG_FRAGMENTS="${ROOT_DIR}/device/<vendor>/<codename>/build.config.<codename>"
KERNEL_DIR=common
DEFCONFIG=gki_defconfig
POST_DEFCONFIG_CMDS="check_defconfig"

# Vendor modules directory (built separately from the generic kernel)
VENDOR_KERNEL_DIR=vendor/<vendor>/<codename>-kernel
VENDOR_KERNEL_BOOT_IMAGE_TYPE=vendor_boot

# ABI/KMI tracking — only touch these deliberately, an unintentional
# ABI break here is one of the most common GKI-specific build failures
ABI_DEFINITION=common/android/abi_gki_aarch64.xml
KMI_SYMBOL_LIST=common/android/abi_gki_aarch64_qcom   # example, varies per vendor
TRIM_NONLISTED_SYMBOLS=1
